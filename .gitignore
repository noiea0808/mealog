# Gemini API Key 설정 파일 (민감한 정보)
js/config.js

# 로컬 빌드 주입 (KAKAO_JAVASCRIPT_KEY 등) — 커밋 금지
.env
.env.local

# Firebase Functions 환경 변수 (민감한 정보)
functions/.env
functions/.env.*
!functions/.env.example

# Node modules (프로젝트에 사용되지 않지만 일반적으로 제외)
node_modules/
www/
functions/node_modules/

# 로그 파일
*.log
functions/*.log

# OS 파일
.DS_Store
Thumbs.db

# Android Release 서명 (민감한 정보)
android/keystore.properties
android/*.keystore
android/*.jks

# Firebase 서비스 계정 키 (로컬 스크립트용, 커밋 금지)
*firebase-adminsdk*.json

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.vercel
