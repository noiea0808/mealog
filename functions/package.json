{
  "name": "mealog-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Mealog with rate limiting and spam filtering",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:sharedPhotos": "node scripts/migrate-shared-photos-timestamp.js",
    "backfill:nicknameClaims": "node scripts/backfill-nickname-claims.js",
    "shift-demo-dates": "node scripts/shift-demo-user-dates.js",
    "set-demo-password": "node scripts/set-demo-user-password.js"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.0.3"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.1.0"
  },
  "private": true
}
