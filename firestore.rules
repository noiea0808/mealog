rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ADMIN 권한 확인 함수
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/artifacts/mealog-r0/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/artifacts/mealog-r0/admins/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // 사용자 본인 확인 함수
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // 인증 확인 함수
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // 공용 데모 계정(샘플 데이터) — 클라이언트 쓰기 차단 (js/config·demo-account 이메일과 동일)
    function isReadOnlyDemoAccount() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email == 'dummy@mealog.net';
    }
    
    // 리소스의 userId가 현재 사용자인지 확인
    function isOwnerOfResource() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // 요청 리소스의 userId가 현재 사용자인지 확인
    function isOwnerOfRequestResource() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // 리소스의 authorId가 현재 사용자인지 확인
    function isAuthorOfResource() {
      return isAuthenticated() && resource.data.authorId == request.auth.uid;
    }
    
    // 요청 리소스의 authorId가 현재 사용자인지 확인
    function isAuthorOfRequestResource() {
      return isAuthenticated() && request.resource.data.authorId == request.auth.uid;
    }
    
    // App Check 토큰 확인 함수 (향후 사용을 위해 추가)
    function hasValidAppCheckToken() {
      return request.appCheck != null && request.appCheck.token != null;
    }
    
    // ============================================
    // 사용자 데이터 (users 컬렉션)
    // ============================================
    match /artifacts/{appId}/users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && !isReadOnlyDemoAccount();
      allow update: if isOwner(userId) && !isReadOnlyDemoAccount();
      allow delete: if false;
      
      // 식사 기록 (meals 서브컬렉션)
      match /meals/{mealId} {
        // 서브컬렉션에서 부모 경로의 userId 변수 참조는 지원되지만, 명시적으로 작성하여 안정성 확보
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow create, update, delete: if request.auth != null && request.auth.uid == userId && !isReadOnlyDemoAccount();
      }
      
      // 사용자 설정 (config 서브컬렉션)
      match /config/{configId} {
        // 서브컬렉션에서 부모 경로의 userId 변수 참조는 지원되지만, 명시적으로 작성하여 안정성 확보
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow create, update, delete: if request.auth != null && request.auth.uid == userId && !isReadOnlyDemoAccount();
      }
      // config/settings만 로그인 사용자 읽기 허용 (갤러리 등에서 다른 사용자 프로필 표시용)
      match /config/settings {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId && !isReadOnlyDemoAccount();
      }
      // stats 연도별 서브컬렉션 (config/stats/years/{year}) - Cloud Functions만 쓰기
      match /config/stats {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
        allow write: if false;
        match /years/{year} {
          allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
          allow write: if false;
        }
      }
    }
    
    // ============================================
    // 둘러보기(게스트) 방문 기록 — 관리자 대시보드 통계용
    // ============================================
    match /artifacts/{appId}/guestVisits/{docId} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == docId;
      allow delete: if false;
    }
    
    // ============================================
    // 공유 사진 (sharedPhotos 컬렉션)
    // ============================================
    // 보안 강화: create는 Cloud Functions 또는 관리자만 허용 (관리자 동기화 버튼용)
    match /artifacts/{appId}/sharedPhotos/{photoId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAuthenticated() && !isReadOnlyDemoAccount() &&
                     resource.data.userId == request.auth.uid && 
                     request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isOwnerOfResource() && !isReadOnlyDemoAccount());
    }
    
    // ============================================
    // 관리자 (admins 컬렉션)
    // ============================================
    match /artifacts/{appId}/admins/{adminId} {
      allow read: if isAdmin() || isOwner(adminId);
      allow write: if false;
    }
    
    // 관리자 설정 (공지·댓글 표시 이름 등) - 읽기는 인증 사용자, 쓰기는 관리자만
    match /artifacts/{appId}/adminSettings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // 사용자 제재 (공유/글쓰기 금지) - 관리자만 읽기/쓰기
    match /artifacts/{appId}/userBans/{userId} {
      allow read, write: if isAdmin();
    }
    
    // 닉네임 중복 방지 인덱스 — 본인 클레임만 생성/수정/삭제, 읽기는 로그인 사용자
    match /artifacts/{appId}/nicknameClaims/{claimId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // 사용자 삭제 요청 (관리자 생성 → Cloud Functions에서 처리 후 삭제)
    match /artifacts/{appId}/deleteUserRequests/{requestId} {
      allow create: if isAdmin();
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    
    // ============================================
    // 게시판 (boardPosts 컬렉션)
    // ============================================
    // 보안 강화: create는 Cloud Functions를 통해서만 허용 (레이트 리밋 및 스팸 필터 적용)
    match /artifacts/{appId}/boardPosts/{postId} {
      allow read: if isAuthenticated();
      // create는 Cloud Functions를 통해서만 허용 (클라이언트 직접 쓰기 차단)
      allow create: if false;
      // 수정/삭제: 관리자 또는 작성자. 조회수(views)·댓글수(comments)·좋아요/비추(likes·dislikes)만 바꿀 때는 로그인 사용자 허용
      // (Cloud Functions는 admin SDK로 쓰므로 Rules를 우회하여 업데이트 가능)
      allow update: if isAdmin() || (isAuthorOfResource() && !isReadOnlyDemoAccount()) || (
        isAuthenticated() && !isReadOnlyDemoAccount() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dislikes']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
        )
      );
      allow delete: if isAdmin() || (isAuthorOfResource() && !isReadOnlyDemoAccount());
    }
    
    // ============================================
    // 밀톡 피드 (feedPosts) — 게시판(boardPosts)과 데이터 분리, create는 CF만
    // ============================================
    match /artifacts/{appId}/feedPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if false;
      allow update: if isAdmin() || (isAuthorOfResource() && !isReadOnlyDemoAccount());
      allow delete: if isAdmin() || (isAuthorOfResource() && !isReadOnlyDemoAccount());

      match /reactions/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated()
          && request.auth.uid == userId
          && !isReadOnlyDemoAccount()
          && request.resource.data.keys().hasOnly(['type', 'updatedAt'])
          && request.resource.data.type in ['like', 'thumbs', 'check'];
        // 관리자: 글 삭제 시 하위 반응 일괄 정리
        allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId && !isReadOnlyDemoAccount());
      }
    }
    
    // ============================================
    // 게시판 상호작용 (boardInteractions 컬렉션)
    // ============================================
    match /artifacts/{appId}/boardInteractions/{interactionId} {
      allow read: if isAuthenticated();
      allow create: if isOwnerOfRequestResource() && !isReadOnlyDemoAccount();
      allow update: if isOwnerOfResource() && !isReadOnlyDemoAccount();
      allow delete: if isOwnerOfResource() && !isReadOnlyDemoAccount();
    }
    
    // ============================================
    // 게시판 북마크 (boardBookmarks 컬렉션)
    // ============================================
    match /artifacts/{appId}/boardBookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwnerOfRequestResource() && !isReadOnlyDemoAccount();
      allow update: if false;
      allow delete: if isOwnerOfResource() && !isReadOnlyDemoAccount();
    }
    
    // ============================================
    // 게시판 댓글 (boardComments 컬렉션)
    // ============================================
    // 보안 강화: create는 Cloud Functions를 통해서만 허용 (레이트 리밋 및 스팸 필터 적용)
    match /artifacts/{appId}/boardComments/{commentId} {
      allow read: if isAuthenticated();
      // create는 Cloud Functions를 통해서만 허용 (클라이언트 직접 쓰기 차단)
      allow create: if false;
      allow update: if isAuthorOfResource() && !isReadOnlyDemoAccount();
      allow delete: if isAdmin() || (isAuthorOfResource() && !isReadOnlyDemoAccount());
    }
    
    // ============================================
    // 게시판 사용자 (boardUsers 컬렉션)
    // ============================================
    match /artifacts/{appId}/boardUsers/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && !isReadOnlyDemoAccount();
      allow delete: if false;
    }
    
    // ============================================
    // 피드 좋아요 (postLikes 컬렉션)
    // ============================================
    match /artifacts/{appId}/postLikes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isOwnerOfRequestResource() && !isReadOnlyDemoAccount();
      allow update: if false;
      allow delete: if isOwnerOfResource() && !isReadOnlyDemoAccount();
    }
    
    // ============================================
    // 피드 북마크 (postBookmarks 컬렉션)
    // ============================================
    match /artifacts/{appId}/postBookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwnerOfRequestResource() && !isReadOnlyDemoAccount();
      allow update: if false;
      allow delete: if isOwnerOfResource() && !isReadOnlyDemoAccount();
    }
    
    // ============================================
    // 피드 댓글 (postComments 컬렉션)
    // ============================================
    // 보안 강화: create는 Cloud Functions를 통해서만 허용 (레이트 리밋 및 스팸 필터 적용)
    match /artifacts/{appId}/postComments/{commentId} {
      allow read: if isAuthenticated();
      // create는 Cloud Functions를 통해서만 허용 (클라이언트 직접 쓰기 차단)
      allow create: if false;
      allow update: if isOwnerOfResource() && !isReadOnlyDemoAccount();
      allow delete: if isOwnerOfResource() && !isReadOnlyDemoAccount();
    }
    
    // ============================================
    // 게시물 신고 (postReports 컬렉션)
    // ============================================
    // 보안 강화: create는 Cloud Functions를 통해서만 허용 (레이트 리밋 및 중복 신고 방지)
    match /artifacts/{appId}/postReports/{reportId} {
      allow read: if isAdmin();
      // create는 Cloud Functions를 통해서만 허용 (클라이언트 직접 쓰기 차단)
      allow create: if false;
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // 공지사항 (notices 컬렉션) - 관리자 전용
    // ============================================
    match /artifacts/{appId}/notices/{noticeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    // 공지 조회 기록 (같은 사용자 중복 1회) — 로그인 사용자만 자신의 문서 생성/병합
    match /artifacts/{appId}/notices/{noticeId}/views/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated() && request.auth.uid == userId && !isReadOnlyDemoAccount();
      allow delete: if false;
    }
    
    // ============================================
    // 관리자 예약 푸시 (adminScheduledPushes) — 관리자만, Functions가 발송 처리
    // ============================================
    // scheduledAt은 클라이언트 시계·서버 시계 차이로 과거로 오인될 수 있어 규칙에서 미래 강제하지 않음
    // (클라이언트에서 최소 1분 후 검증 + 스케줄러가 도래 시점에만 발송)
    match /artifacts/{appId}/adminScheduledPushes/{jobId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 240
        && request.resource.data.landingTab is string
        && request.resource.data.scheduledAt is timestamp;
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // 팝업 (popups 컬렉션) - 관리자 작성, 사용자 읽기, 조회/클릭 수는 로그인 사용자 업데이트 허용
    // ============================================
    match /artifacts/{appId}/popups/{popupId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
         || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
         || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'clickCount']))
      );
      match /views/{userId} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }
      match /clicks/{userId} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
    
    // ============================================
    // 공지 북마크 (noticeBookmarks 컬렉션)
    // ============================================
    match /artifacts/{appId}/noticeBookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwnerOfRequestResource() && !isReadOnlyDemoAccount();
      allow update: if false;
      allow delete: if isOwnerOfResource() && !isReadOnlyDemoAccount();
    }
    
    // ============================================
    // 공지 반응 (noticeInteractions 컬렉션) - 하트(좋아요)
    // ============================================
    match /artifacts/{appId}/noticeInteractions/{interactionId} {
      allow read: if isAuthenticated();
      allow create: if isOwnerOfRequestResource() && !isReadOnlyDemoAccount();
      allow update: if isOwnerOfResource() && !isReadOnlyDemoAccount();
      allow delete: if isOwnerOfResource() && !isReadOnlyDemoAccount();
    }
    
    // ============================================
    // 앱 설정 (config 컬렉션) - 로그인 배너 등
    // loginBanner: 비로그인 포함 누구나 읽기, 쓰기는 관리자만. 조회/클릭 수는 통계용으로 업데이트 허용
    // ============================================
    match /artifacts/{appId}/config/loginBanner {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'clickCount'])
      );
      allow delete: if isAdmin();
      match /views/{userId} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }
      match /clicks/{userId} {
        allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }
    match /artifacts/{appId}/config/{configId} {
      allow read, write: if isAdmin();
    }

    // ============================================
    // 콘텐츠 (content 컬렉션) - 관리자 전용
    // apk 문서는 누구나 읽기 가능 (다운로드 페이지용)
    // ============================================
    match /artifacts/{appId}/content/{contentId} {
      allow read: if isAuthenticated() || contentId == 'apk';
      allow write: if isAdmin();
      
      // 약관 버전 (terms 문서의 하위 컬렉션) - contentId가 'terms'일 때만 매칭
      match /versions/{versionId} {
        // contentId가 'terms'인지 확인
        allow read: if isAuthenticated() && contentId == 'terms';
        allow write: if isAdmin() && contentId == 'terms';
      }
    }
    
    // ============================================
    // 캐릭터 (persona 컬렉션) - 관리자 전용
    // ============================================
    match /artifacts/{appId}/persona/{personaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============================================
    // 에러 로그 (errorLogs 컬렉션) - 관리자만 읽기 가능, 쓰기는 Cloud Functions만
    // ============================================
    match /artifacts/{appId}/errorLogs/{errorId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions만 쓰기 가능 (admin SDK 사용)
    }

    // ============================================
    // Collection group 'meals' — 관리자 피드(타임라인 전체) 조회용
    // 경로 규칙과 별도로, collection group 쿼리·집계에 필요 (쓰기는 기존 users/meals 규칙만 사용)
    // ============================================
    match /{path=**}/meals/{mealId} {
      allow read: if isAdmin();
    }
  }
}
