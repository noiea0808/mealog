rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 사용자별 폴더: meals, temp, migrated, board, profile 등
    // 인증된 사용자만 자신의 경로(users/{userId}/**)에 읽기/쓰기 가능
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
