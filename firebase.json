{
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix functions install"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "predeploy": [
      "node scripts/verify-deploy-config.js"
    ],
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "scripts/**",
      "functions/**",
      "tools/**",
      "config/**",
      "dev/**",
      "test/**",
      "www/**",
      "docs/*.md",
      "docs/growth/**",
      "*.md",
      "*.ps1",
      "*.bat",
      "*.rules",
      "firestore.indexes.json",
      "capacitor.config*.json",
      "package.json",
      "package-lock.json",
      "tailwind.config.js",
      "eslint.config.mjs"
    ]
  }
}
